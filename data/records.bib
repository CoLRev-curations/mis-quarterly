   colrev_pdf_id                 = {cpid2:fffffffffcffffffe007ffffc0020003e0f20007ffffffffe0000007e0000007fffc3fffff0000ffffe007ffffc003fff81b501ff800001ff800001ff800001ff800001ff800001ff985ffffffffffffe000ffffe0018007e0018007e0018007e0018007e0018007ffffffffe0ffffffe3b7ffffffffffffffffffffffffffff},
   file                          = {data/pdfs/41_4/KimMithasKimbrough2017.pdf},
   doi                           = {10.25300/MISQ/2017/41.4.15},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/KimMK17},
   author                        = {Kim, Keongtae and Mithas, Sunil and Kimbrough, Michael},
   journal                       = {MIS Quarterly},
   title                         = {Information Technology Investments and Firm Risk Across Industries - Evidence from the Bond Market},
   year                          = {2017},
   volume                        = {41},
   number                        = {4},
   pages                         = {1347--1367},
   url                           = {https://misq.org/information-technology-investments-and-firm-risk-across-industries-evidence-from-the-bond-market.html},
   abstract                      = {This study documents variation across industries in creditors’ perceptions of the risk of information technology (IT) investments. The associations we document between IT investments and both initial bond ratings and yield spreads suggest that credit-rating agencies and bond investors consider IT investments in automate and informate industries less risky than those in transform industries. We document that IT investments are associated with more volatile future cash flows in transform industries than in automate or informate industries. The findings indicate that bond investors prefer IT investments in automate industries, where the cash flow payoffs to IT investment are smaller but more stable than in transform industries. Overall, these findings provide the important insight that bondholders’ perceptions of IT investments vary across industries based on bondholders’ aversion to the riskiness and the lack of collateralizability of IT investments. Senior managers should recognize that IT investments have implications for both operational performance and financing costs (e.g., costs of debt) of the firm, and they should consider the potential financial benefits of increased IT capabilities, such as the willingness of corporate bond investors to accept lower financing costs.},
   cited_by                      = {18},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/41/4/1347/6027/15_13759_rn_kimmithas.pdf},
   language                      = {eng},
}

