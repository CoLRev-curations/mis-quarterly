@article{AlhauliElmaghrabyGopal2022,
   colrev_origin                 = {CROSSREF.bib/002001;
                                    pdfs.bib/0000001733;},
   colrev_status                 = {rev_prescreen_included},
   colrev_masterdata_provenance  = {journal:pdfs.bib/0000001733;;
