   colrev_data_provenance        = {file:pdfs.bib/0000000359;;
                                    doi:pdfs.bib/0000000359;;
                                    url:DBLP.bib/001378;;
                                    abstract:CROSSREF.bib/000571;;
                                    colrev.dblp.dblp_key:CROSSREF.bib/000571;;
