@article{LeongHsuGoonawardeneEtAl2025a,
   colrev_origin                 = {CROSSREF.bib/002049;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {author:CROSSREF.bib/002049;;
                                    journal:CROSSREF.bib/002049;;
