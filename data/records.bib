   colrev_pdf_id                 = {cpid2:fffffffffc7fffffe007ffffe0020003e0f20007fdfffffff000000ffffc3fffffc003fffff00ffffff40fffffe007fffdfffffff800001ff800001ff800001ff800001ff800001ff800003ff82554bff9ffffffe200ffffe0008007e00196ffe001bf7fe0018007e0018007ff7f8007ffffffffffffffffffffffffffffffff},
