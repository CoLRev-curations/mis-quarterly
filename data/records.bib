   colrev_masterdata_provenance  = {journal:DBLP.bib/001294;;
                                    year:DBLP.bib/001294;;
                                    volume:DBLP.bib/001294;;
                                    number:DBLP.bib/001294;;
                                    author:DBLP.bib/001294;;
