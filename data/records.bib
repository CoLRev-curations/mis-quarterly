   author                        = {Masli, Adi and Richardson, Vernon J. and Watson, Marcia Weidenmier and Zmud, Robert W.},
   journal                       = {MIS Quarterly},
   title                         = {Senior Executives' IT Management Responsibilities - Serious IT-Related Deficiencies and CEO/CFO Turnover},
   year                          = {2016},
   volume                        = {40},
