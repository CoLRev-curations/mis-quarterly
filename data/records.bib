   author                        = {Benitez, Jose and Ray, Gautam and Henseler, Jörg},
   journal                       = {MIS Quarterly},
   title                         = {Impact of Information Technology Infrastructure Flexibility on Mergers and Acquisitions},
   year                          = {2018},
   volume                        = {42},
   number                        = {1},
   pages                         = {25--43},
   url                           = {https://misq.org/impact-of-information-technology-infrastructure-flexibility-on-mergers-and-acquisitions.html},
   abstract                      = {Although mergers and acquisitions (M&A) are a common strategy to reduce costs and pursue growth, the variance in returns from M&A is very high. This research examines how information technology (IT) infrastructure flexibility affects M&A. We use a combination of secondary as well as matched-pair survey data from 100 midsize firms in Spain to investigate this relationship. The empirical analysis suggests that IT infrastructure flexibility affects M&A through two key pathways: (1) a flexible IT infrastructure facilitates the development of business flexibility that provides the responsiveness to seize M&A opportunities and make acquisitions, and (2) a flexible IT infrastructure facilitates the development of post-M&A IT integration capability that provides the control to integrate the IT and business resources of the acquired firm and realize the economic benefits from M&A.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/42/1/25/6131/02_13245_ra_benitezray.pdf},
   language                      = {eng},
}

