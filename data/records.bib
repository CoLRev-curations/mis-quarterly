@article{SeidelFrickvomBrocke2025,
   colrev_origin                 = {CROSSREF.bib/002008;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {author:CROSSREF.bib/002008;;
                                    journal:CROSSREF.bib/002008;;
