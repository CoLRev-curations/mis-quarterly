@article{GomezPalomas2024,
   colrev_origin                 = {CROSSREF.bib/001947;
                                    DBLP.bib/001521;},
   colrev_status                 = {rev_prescreen_included},
   colrev_masterdata_provenance  = {author:DBLP.bib/001521;;
                                    journal:DBLP.bib/001521;;
                                    number:DBLP.bib/001521;;
