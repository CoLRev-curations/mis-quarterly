   colrev_pdf_id                 = {cpid2:fffffffffcffffffc007ffffc0020003e0d20007fffffffffc00003ff000000ffffc3fffff4003ffffe007ffff8001fffffc3fffffe007fffffc3fffff8001fff800001ff800001ff800001ff800001ff800001ff800001ff800001ffbfffffff900001ffffffffffffffffffffffffff7a3bfffffffffffffffffffffffffff},
   file                          = {data/pdfs/42_1/GopalHidajiPattersonEtAl2018.pdf},
   doi                           = {10.25300/MISQ/2018/13839},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/GopalHPRZ18},
   author                        = {Gopal, Ram D. and Hidaji, Hooman and Patterson, Raymond A. and Rolland, Erik and Zhdanov, Dmitry},
   journal                       = {MIS Quarterly},
   title                         = {How Much to Share with Third Parties? User Privacy Concerns and Website Dilemmas},
   year                          = {2018},
   volume                        = {42},
   number                        = {1},
   pages                         = {143--164},
   url                           = {https://misq.org/how-much-to-share-with-third-parties-user-privacy-concerns-and-website-dilemmas.html},
   abstract                      = {Publishers websites are increasingly presenting content and services that are not created and managed by the website administrators themselves, but are provided by other third parties. While third party content and services provide value and utility to website users, this comes at the cost of user information being shared with the third party. Privacy concerns surrounding information leakage have been growing rapidly. With increasing concerns regarding online privacy and information disclosure, it is important to understand the factors that affect the level of sharing between publisher websites and third parties. In this study, we propose a two-sided economic model that captures the interaction between the users, publisher websites, and third parties. Specifically, we focus on the effect of privacy concerns on the sharing behavior of the publisher website and the impact of users’ privacy concerns on third party market concentration. We then analyze welfare aspects to provide insights on the impacts of industry regulations and policy on users, publisher websites, and third parties. We partially validate the model using an exploratory empirical analysis of publisher website third party sharing behavior and the structure of the industry. To the best of our knowledge, this study is among the first to analyze publisher website decision making in sharing user information with third parties.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/42/1/143/6109/08_13839_ra_gopalhidaji.pdf},
   language                      = {eng},
}

