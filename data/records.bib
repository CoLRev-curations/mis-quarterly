   colrev_pdf_id                 = {cpid2:fffffffffcffffffe007ffffc0020003e0f20007fffffffff000000ff800001ffe00007ffffc3ffffff00ffffff81ffffff41ffffffc3fffffe087fff800001ff800001ff800001ff800001ff80ffffff9bfffffffffffffe000807fe0018007e0018007e0018007e0018007ffff8007ee7f8fefffffffffffffffffffffffff},
   file                          = {data/pdfs/44_4/BouayadPadmanabhanChari2020.pdf},
   doi                           = {10.25300/MISQ/2020/14435},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/BouayadPC20},
   author                        = {Bouayad, Lina and Padmanabhan, Balaji and Chari, Kaushal},
   journal                       = {MIS Quarterly},
   title                         = {Can Recommender Systems Reduce Healthcare Costs? The Role of Time Pressure and Cost Transparency in Prescription Choice},
   year                          = {2020},
   volume                        = {44},
   number                        = {4},
   pages                         = {1859--1903},
   url                           = {https://misq.org/can-recommender-systems-reduce-healthcare-costs-the-role-of-time-pressure-and-cost-transparency-in-prescription-choice.html},
   abstract                      = {This paper presents and synthesizes results from three studies (two controlled experiments and one interview) on using recommender systems to reduce healthcare costs at prescription time, while taking time pressure into account. All of our subjects were real practicing physicians, nurse practitioners, or physician assistants. Across these studies, a total of 160 medical practitioners used a system that provides recommendations for medications along with associated cost information. The main finding was a general tendency among practitioners to reduce healthcare costs by prescribing lower cost medications when cost information is provided by a recommender system. The time pressure faced daily by prescribers, however, appears to impact the use of recommendations by nurse practitioners and physician assistants more than it does physicians. These results have significant implications for cost reduction in healthcare and for the design of effective real-time healthcare recommender systems.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/44/4/1859/6524/12_14435_ra_bouayad.pdf},
   language                      = {eng},
}

