   doi                           = {10.25300/MISQ/2017/41.1.17},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/KyriakouNS17},
   author                        = {Kyriakou, Harris and Nickerson, Jeffrey V. and Sabnis, Gaurav},
   journal                       = {MIS Quarterly},
   title                         = {Knowledge Reuse for Customization - Metamodels in an Open Design Community for 3D Printing},
   year                          = {2017},
   volume                        = {41},
   number                        = {1},
   pages                         = {315--332},
   url                           = {https://misq.umn.edu/knowledge-reuse-for-customization-metamodels-in-an-open-design-community-for-3d-printing.html},
   abstract                      = {Theories of knowledge reuse posit two distinct processes: reuse for replication and reuse for innovation. We identify another distinct process, reuse for customization. Reuse for customization is a process in which designers manipulate the parameters of metamodels to produce models that fulfill their personal needs. We test hypotheses about reuse for customization in Thingiverse, a community of designers that shares files for three-dimensional printing. 3D metamodels are reused more often than the 3D models they generate. The reuse of metamodels is amplified when the metamodels are created by designers with greater community experience. Metamodels make the community’s design knowledge available for reuse for customization—or further extension of the metamodels, a kind of reuse for innovation.},
   cited_by                      = {51},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/41/1/315/5954/17_13568_sirn_kyriakou.pdf},
   language                      = {eng},
}

