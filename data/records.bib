                                    url:DBLP.bib/001317;;
                                    colrev.dblp.dblp_key:CROSSREF.bib/000583;;
                                    language:CROSSREF.bib/000583;;
                                    abstract:ORIGINAL;;
                                    fulltext:ORIGINAL;;},
   colrev_pdf_id                 = {cpid2:fffffffffcffffffc007ffffc0020003e0920007fdfffffffc00003fffc003fffffc3fffffc007fffffc3fffffe007fffff81ffffff00ffffffc3fffffe007fff800001ff800001ffbfffffff800001ff800001ff8001ddff800011ff8aee11ff88108ffffffffffffffffffffffffffffff7fffffffffffffffffffffffffff},
   file                          = {data/pdfs/44_2/DanaherHershSmithEtAl2020.pdf},
   doi                           = {10.25300/MISQ/2020/15791},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/DanaherHST20},
   author                        = {Danaher, Brett and Hersh, Jonathan and Smith, Michael D. and Telang, Rahul},
   journal                       = {MIS Quarterly},
   title                         = {The Effect of Piracy Website Blocking on Consumer Behavior},
   year                          = {2020},
   volume                        = {44},
   number                        = {2},
   pages                         = {631--660},
   url                           = {https://misq.org/the-effect-of-piracy-website-blocking-on-consumer-behavior.html},
   abstract                      = {In this study, we ask what drives the success or failure of various supply-side anti-piracy enforcement actions such as piracy website blocking. We do this in the context of three court-ordered events affecting consumers in the United Kingdom: We first study Internet Service Providers’ blocking of 53 video piracy sites in 2014 and of 19 piracy sites in 2013, and we then study the blocking of a single dominant site, “The Pirate Bay,” in 2012. We show that blocking 53 sites in 2014 caused treated users to decrease piracy and to increase their usage of legal subscription sites between 7% and 12%. It also caused an increase in new paid subscriptions. We find similar results for the blocking of 19 piracy sites in 2013. However, blocking a single site in 2012 caused no increase in usage of legal sites but instead caused users to increase visits to other unblocked piracy sites and VPN sites. We find evidence that increased search and learning costs associated with piracy drive the effectiveness of blocking multiple sites rather than just one primary site. This suggests that to increase legal IP use when faced with a dominant piracy channel, the optimal policy response must block multiple channels of access to pirated content, a distinction that the current literature has not made clear.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/44/2/631/1998/05_15791_ra_danaherhersh.pdf},
   language                      = {eng},
}

@article{DanatzisChandlerAkakaEtAl2024,
   colrev_origin                 = {CROSSREF.bib/001997;
                                    DBLP.bib/001514;},
   colrev_status                 = {rev_prescreen_included},
   colrev_masterdata_provenance  = {author:DBLP.bib/001514;;
                                    journal:DBLP.bib/001514;;
                                    number:DBLP.bib/001514;;
                                    pages:DBLP.bib/001514;;
                                    title:DBLP.bib/001514;;
                                    volume:DBLP.bib/001514;;
                                    year:DBLP.bib/001514;;},
   colrev_data_provenance        = {colrev.dblp.dblp_key:DBLP.bib/001514;;
                                    doi:DBLP.bib/001514;;
                                    language:LanguageDetector;;
                                    url:CROSSREF.bib/001997;;
                                    abstract:CROSSREF.bib/001997;;
                                    dblp_key:ORIGINAL;;
                                    fulltext:ORIGINAL;;},
   doi                           = {10.25300/MISQ/2024/18334},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/DanatzisCAN24},
   author                        = {Danatzis, Ilias and Chandler, Jennifer D. and Akaka, Melissa A. and Ng, Irene C. L.},
   journal                       = {MIS Quarterly},
   title                         = {Designing Digital Platforms for Social Justice: Empowering End Users through the Dataswyft Platform},
   year                          = {2024},
   volume                        = {48},
   number                        = {4},
   pages                         = {1771--1802},
   url                           = {https://misq.umn.edu/designing-digital-platforms-for-social-justice-empowering-end-users-through-the-dataswyft-platform.html},
   abstract                      = {Digital platforms have radically transformed how we work, shop, and socialize. Despite their numerous benefits, they may also threaten social justice due to unforeseen consequences of specific design choices, preventing end users from participating equitably in the digital economy. As platform owners compete by leveraging personal data, it remains unclear how digital platforms can be designed to empower end users to control, legally own, and benefit from their data in a privacy-preserving way. Integrating design science research with heuristic theorizing, this study proposes a design theory for end user-centric digital platforms. We derive design theory components from over nine years of data regarding the Dataswyft platform, including five meta-requirements and eight design principles. They reveal how digital platforms can be designed for social justice by empowering end users, both technically and legally, to protect and control their data through a containerized microservice platform infrastructure. This platform design includes multiple data protection layers, end user-driven data collection, reconfiguration, and exchange functionalities, safeguarding mechanisms, and semi-centralized ecosystem governance structures. By evaluating an expository instantiation of the proposed design principles, we demonstrate the applicability and utility of our design theory, paving the way for data self-sovereignty and social sustainability.},
   dblp_key                      = {https://dblp.org/rec/journals/misq/DanatzisCAN24},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/48/4/1771/9553/18_si_10_25300_misq_2024_18334.pdf},
   language                      = {eng},
}

@article{DanielMarupingCataldoEtAl2018,
