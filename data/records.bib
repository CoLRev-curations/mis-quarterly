                                    journal:CROSSREF.bib/002083;;
                                    number:CROSSREF.bib/002083;;
                                    pages:CROSSREF.bib/002083;;
                                    title:CROSSREF.bib/002083;;
                                    volume:CROSSREF.bib/002083;;
                                    year:CROSSREF.bib/002083;;},
   colrev_data_provenance        = {abstract:CROSSREF.bib/002083;;
                                    doi:CROSSREF.bib/002083;;
                                    fulltext:CROSSREF.bib/002083;;
                                    language:CROSSREF.bib/002083;;},
   doi                           = {10.25300/MISQ/2024/17614},
   author                        = {Lei, Zhanfei and Yin, Dezhi and Zhang, Han},
   journal                       = {MIS Quarterly},
   title                         = {Deliberative or Automatic: Disentangling the Dual Processes Behind the Persuasive Power of Online Word-of-Mouth},
   year                          = {2025},
   volume                        = {49},
   number                        = {1},
   pages                         = {331--346},
   abstract                      = {As online reviews become increasingly indispensable for consumers, they have attracted significant attention from both practitioners and researchers. It is a common belief that the persuasive effect of online reviews involves a deliberative and conscious process. Drawing on dual-process theories and the persuasion literature, we challenge this conventional wisdom, distinguish Type 2 processing (which requires deliberation) and Type 1 processing (which occurs automatically), and disentangle their relative impacts. With a focus on review elaborateness and review exposure, we propose that the automatic process of review exposure may play a greater role than elaborateness in changing consumers’ attitudes and purchase intentions. In addition, in line with the negativity bias, we posit that the persuasive impact of review exposure (vs. elaborateness) is moderated by the valence of highly exposed reviews. The results of the two experiments provide consistent support for these predictions. Our findings complement and extend the emerging literature starting to explore the role of automatic Type 1 processing in consumers’ use of online reviews, reveal the primary driver of persuasion and its boundary condition in online word-of-mouth, and provide important implications for review platforms, product manufacturers, and retailers.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/49/1/331/1758/12_rn_10.25300_misq_2024_17614.pdf},
   language                      = {eng},
}

