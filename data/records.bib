@article{MithasChenLiuEtAl2022,
   colrev_origin                 = {CROSSREF.bib/001922;
                                    pdfs.bib/001783;},
   colrev_status                 = {rev_prescreen_included},
   colrev_masterdata_provenance  = {journal:pdfs.bib/001783;;
