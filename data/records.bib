                                    language:CROSSREF.bib/002039;;},
   doi                           = {10.25300/MISQ/2025/49.1.075},
   author                        = {Schneier, Bruce and Vance, Anthony},
   journal                       = {MIS Quarterly},
   title                         = {Guest Editorial: “Complexity is the Worst Enemy of Security”: Studying Cybersecurity Through the Lens of Organizational Complexity},
   year                          = {2025},
   volume                        = {49},
   number                        = {1},
   pages                         = {205--210},
   abstract                      = {Writing about computer systems twenty-five years ago, Schneier wrote that “the worst enemy of security is complexity” (Schneier, 1999), because complex systems are both easier to attack and harder to secure than simpler ones. In this essay, we provide an overview of Schneier’s complexity principle and provide our observations of how two articles in this issue, Liang et al. (2025) and Tanriverdi et al. (2025), employed this principle in their research. We also offer our ideas for why complexity and cybersecurity are especially amenable for study in the field of information systems and where future research can go from here.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/49/1/205/1763/ed_10.25300_misq_2025_02.pdf},
   language                      = {eng},
}

