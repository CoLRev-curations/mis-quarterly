   colrev_pdf_id                 = {cpid2:fffffffffcffffffc007ffffc0020003e0d20007fffffffff000000ffc00007ffffe7fffffe007fffffe7fffffb00dfffffc9fffff8001ffffd7e3fff800001ff800001ff800001ff91fda9ff9fffffff800003fffffffffe0008007e0018007e00181ffe0018007ffff8007e03f8007e00f8007ffffffffffffffffffffffff},
   file                          = {data/pdfs/40_1/NevoNevoPinsonneault2016.pdf},
   doi                           = {10.25300/MISQ/2016/40.1.07},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/NevoNP16},
   author                        = {Nevo, Saggi and Nevo, Dorit and Pinsonneault, Alain},
   journal                       = {MIS Quarterly},
   title                         = {A Temporally Situated Self-Agency Theory of Information Technology Reinvention},
   year                          = {2016},
   volume                        = {40},
   number                        = {1},
   pages                         = {157--186},
   url                           = {https://misq.umn.edu/a-temporally-situated-self-agency-theory-of-information-technology-reinvention.html},
   abstract                      = {Our knowledge of how users reinvent information technologies (IT) in ways that depart from their intended purposes to achieve new goals is relatively limited. Drawing on a human agency theory that situates actors in the flow of time, this paper develops a theory of IT reinvention. It identifies the key subprocesses of IT reinvention, describes two patterns of reinvention (performance-oriented and mastery-oriented), and explains how the present and the past influence the ambiguities, demands, and dilemmas inherent to each pattern. The outcomes associated with each pattern of IT reinvention are also discussed. The paper provides the theoretical foundations to understand how users reinvent IT as well as new insights into a broader range of post-adoption behaviors.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/40/1/157/5713/07_12276_tr_nevo.pdf},
   language                      = {eng},
}

