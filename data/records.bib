                                    pages:CROSSREF.bib/000298;;
                                    author:CROSSREF.bib/000298;;},
   colrev_data_provenance        = {file:pdfs.bib/0000000530;;
                                    doi:CROSSREF.bib/000298;;
                                    cited_by:CROSSREF.bib/000298;;
                                    language:CROSSREF.bib/000298;;
                                    url:manual;;
                                    abstract:ORIGINAL;;
                                    fulltext:ORIGINAL;;},
   colrev_pdf_id                 = {cpid2:fffffffffcffffffc007ffffc0020003e0920007fffffffff000001ffffc3fffff500dfffff81fffffc003fffffc3fffff8001ffffefcffff800001ff800001ff800001ff800001ff800001ff800001ff800001ff800001ff90007fffffffffffebbfffffe09807fffffffffffffffffe4221fffffffffffffffffffffffffff},
   file                          = {data/pdfs/41_1/KohRaghunathanNault2017.pdf},
   doi                           = {10.25300/MISQ/2017/41.1.02},
   author                        = {Koh, Byungwan and Raghunathan, Srinivasan and Nault, Barrie R.},
   journal                       = {MIS Quarterly},
   title                         = {Is Voluntary Profiling Welfare Enhancing?},
   year                          = {2017},
   volume                        = {41},
   number                        = {1},
   pages                         = {23--41},
   url                           = {https://misq.umn.edu/is-voluntary-profiling-welfare-enhancing.html},
   abstract                      = {Although consumer profiling advocates tout benefits from personalization, consumer advocacy groups oppose profiling in online markets because of concerns about privacy and price discrimination. Policies such as opt-out or opt-in that provide consumers the option to voluntarily participate in profiling are the favored compromise. We compare voluntary profiling to no profiling and show that voluntary profiling leads to some counterintuitive results. Consumers that do not participate in profiling and some that participate are worse off under voluntary profiling. Neither social welfare nor aggregate consumer surplus is necessarily higher under voluntary profiling; even when voluntary profiling leads to an increase in social welfare, it may come at the expense of consumer surplus. If the seller cannot price discriminate and charge only a uniform price for everyone or the seller can only charge different prices based on the consumer’s participation status, then aggregate consumer surplus under voluntary profiling is higher and a reduction in privacy cost has a positive impact on all consumers as well as the seller. However, when personalized pricing is possible, reducing privacy cost alone may reduce aggregate consumer surplus. The primary reason for these results is that voluntary profiling allows the seller to identify high valuation consumers that have no incentive to participate and set a higher price for them (compared to no profiling) while simultaneously benefitting from the profile information of low valuation consumers that participate. However, a positive privacy cost mitigates the participation incentives of even low valuation consumers and hence sellers’ ability to engage in price discrimination.},
   cited_by                      = {22},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/41/1/23/5934/02_12795_ra_kohnault.pdf},
   language                      = {eng},
}

