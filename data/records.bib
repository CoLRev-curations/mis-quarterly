                                    fulltext:ORIGINAL;;},
   colrev_pdf_id                 = {cpid2:fffffffffcffffffe007ffffc0020003e0f20007fffffffff800000ffe00007fffc003fffffc3fffffc003fffffc3fffffe807fffffc7fffffc003fff800001ff800001ff800001ff800001ff80002fff9ff559ffe01ffffe0008007e0418007e0018007e0018007ffffb9ffe07f8007e7878007ffffffffffffffffffffffff},
   file                          = {data/pdfs/42_4/BreznitzFormanWen2018.pdf},
   doi                           = {10.25300/MISQ/2018/13577},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/BreznitzFW18},
   author                        = {Breznitz, Dan and Forman, Chris and Wen, Wen},
   journal                       = {MIS Quarterly},
   title                         = {The Role of Venture Capital in the Formation of a New Technological Ecosystem - Evidence from the Cloud},
   year                          = {2018},
   volume                        = {42},
   number                        = {4},
   pages                         = {1143--1169},
   url                           = {https://misq.umn.edu/the-role-of-venture-capital-in-the-formation-of-a-new-technological-ecosystem-evidence-from-the-cloud.html},
   abstract                      = {The diffusion of new information technology (IT) requires the development of an ecosystem of hardware and software producers, users, and other firms. It is widely believed that venture capitalists (VCs) can play a role in the development of such ecosystems. However, empirical research to elaborate on these points is lacking. Focusing on the recent rapid rise of one platform, cloud computing, we assemble a unique dataset to look at the period just before wide acceptance of the cloud. We find evidence of complementarity between VC financing and the introduction of new products offered over the cloud. Moreover, the complementarity effects are significantly stronger for firms backed by VCs that had rich experience in the IT industry and are significantly weaker for firms that had prior experience developing traditional client/server products. These results provide evidence that supports a role for VC financing in the creation of new technological ecosystems.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/42/4/1143/6204/06_13577_ra_breznitzforman.pdf},
   language                      = {eng},
}

