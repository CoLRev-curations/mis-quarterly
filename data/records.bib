   author                        = {Carmi, Eyal and Oestreicher-Singer, Gal and Stettner, Uriel and Sundararajan, Arun},
   journal                       = {MIS Quarterly},
   title                         = {Is Oprah Contagious? The Depth of Diffusion of Demand Shocks in a Product Network},
   year                          = {2017},
   volume                        = {41},
   number                        = {1},
   pages                         = {207--221},
   url                           = {https://misq.umn.edu/is-oprah-contagious-the-depth-of-diffusion-of-demand-shocks-in-a-product-network.html},
   abstract                      = {Recent studies have documented that the contagion of information and behaviors in social networks is generally quite limited. We examine whether this pattern characterizes exogenous demand shocks diffusing in a product network. To this end, we analyze a unique series of demand shocks induced by mass-media book reviews on the Oprah Winfrey television show and in The New York Times. Our identification strategy is based on a difference-in-differences model estimated using two different groups as control, based on propensity-score-based matching and network proximity to a reviewed book, respectively. Our results show that the diffusion of exogenous demand shocks in the Amazon.com product network is relatively shallow, typically about three edges deep into the network, although the economic impact of this diffusion can often be significant. We link our results to recent findings in the context of diffusion in social networks and discuss managerial implications.},
   cited_by                      = {19},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/41/1/207/5874/10_12833_rn_carmi.pdf},
   language                      = {eng},
}

