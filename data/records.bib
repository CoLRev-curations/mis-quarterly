   colrev_pdf_id                 = {cpid2:fffffffffc7fffffe007ffffe0020003e0f20007fdfffffff000000ffe08007ffffc3ffffff81fffffc003fffffffffff800001ff800001ff800001ff800001ff8cfdf7ff9cffffffe01ffffe0008007e00d8007e0018007e0018007e0018007e0018007e0018007e0018007e6bfffffffffffffffffffffffffffffffffffff},
