   colrev_pdf_id                 = {cpid2:fffffffffcffffffc007ffffc0020003e0920007fffffffff800001ff800001ffffe7fffff6007fffffc3fffffe007fffffc3fffffe007fffffc3fffffc003fff800001ff800001ff800001ff800001ff800001ff800001ff800001ff94ffffff8000fdffffffffffffffffffffffffffff7ffffffffffffffffffffffffffff},
   file                          = {data/pdfs/44_1/LiuZhangSusarlaEtAl2020.pdf},
   doi                           = {10.25300/MISQ/2020/15107},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/LiuZSP20},
   author                        = {Liu, Xiao and Zhang, Bin and Susarla, Anjana and Padman, Rema},
   journal                       = {MIS Quarterly},
   title                         = {Go to You Tube and Call Me in the Morning - Use of Social Media for Chronic Conditions},
   year                          = {2020},
   volume                        = {44},
   number                        = {1},
   pages                         = {257--283},
   url                           = {https://misq.org/go-to-you-tube-and-call-me-in-the-morning-use-of-social-media-for-chronic-conditions.html},
   abstract                      = {Video sharing social media platforms, such as YouTube, offer an effective way to deliver medical information. Few studies have identified evidence-backed digital therapeutics with technology-enabled interventions to improve the ease with which patients can retrieve medical information to manage chronic conditions. We propose an interdisciplinary lens that synthesizes deep learning methods with themes emphasized in Information Systems and Healthcare Informatics research to examine user engagement with encoded medical information in YouTube videos. We first use a bidirectional long short-term memory method to identify medical terms in videos and then classify videos based on whether they encode a high or low degree of medical information. We then employ principal component analysis on aggregate video data to discover three dimensions of collective engagement with videos: nonengagement, selective attention-driven engagement, and sustained attention-driven engagement. Videos with low medical information result in nonengagement; at the same time, videos with a greater amount of encoded medical information struggle to maintain sustained attention-driven engagement. Our study provides healthcare practitioners and policymakers with a nuanced understanding of how users engage with medical information in video format. Our research also contributes to enhancing current public health practices by promoting normative guidelines for educational video content enabling management of chronic conditions.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/44/1/257/608/10_15107_si_cd_liuzhang.pdf},
   language                      = {eng},
}

