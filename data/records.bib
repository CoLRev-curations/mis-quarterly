                                    volume:CROSSREF.bib/001834;;
                                    year:CROSSREF.bib/001834;;},
   colrev_data_provenance        = {abstract:CROSSREF.bib/001834;;
                                    doi:CROSSREF.bib/001834;;
                                    url:CROSSREF.bib/001834;;
                                    language:CROSSREF.bib/001834;;
                                    file:pdfs.bib/001830;;
                                    fulltext:ORIGINAL;;},
   colrev_pdf_id                 = {cpid2:fffffffffc7fffffe007ffffe0020003e0f20007fffffffff000000fff0001fffffc3fffffc003fffff81ffffffbfffff800001ff800001ff800001ff800001ff800001ff800003ff8e36dfffffffffffd9f8007fc018007e000afffe0218007e0018007e0018007e0018007ffffffffe001ffffffffffffffffffffffffffff},
   file                          = {data/pdfs/47_2/BrownSias2023.pdf},
   doi                           = {10.25300/MISQ/2022/17075},
   author                        = {Brown, Susan A. and Sias, Richard W.},
   journal                       = {MIS Quarterly},
   title                         = {The fault in our stars: molecular genetics and information technology use},
   year                          = {2023},
   volume                        = {47},
   number                        = {2},
   pages                         = {483--510},
   url                           = {https://misq.umn.edu/the-fault-in-our-stars-molecular-genetics-and-information-technology-use.html},
   abstract                      = {There is a growing interest in understanding the role of genetics in explaining heterogeneity in behaviors, including those related to information systems (IS). The majority of the recent genetics research focuses on searching the entire genome in genome-wide association studies (GWASs) to link DNA to human traits. The results of GWASs can be used on datasets to compute a measure of genetic propensity known as a polygenic score, or PGS. PGSs are widely viewed as the future of genetics research. We conducted an exploratory study, in the context of information technology (IT) use, to examine if the PGS approach can be used to better understand the role of genetics in IS research. Consistent with our hypotheses, genetic endowments associated with Educational Attainment and General Cognition positively predict technology use, and genetic endowments associated with Neuroticism, Depressive Symptoms, Myocardial Infarction, and Coronary Artery Disease negatively predict technology use more than half a century later (genetic endowments are established at conception and our sample consists of individuals aged 50 to 80). Many of the characteristics known to be associated with heterogeneity in IT use (e.g., trust, education) appear to be mediators linking PGSs to IT use. Nonetheless, a number of PGSs maintain meaningful direct effects.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/47/2/483/8798/01_ra_10_25300_misq_2022_17075.pdf},
   language                      = {eng},
}

