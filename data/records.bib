   colrev_pdf_id                 = {cpid2:fffffffffc7fffffe007ffffe0020003e0d20007fffffffffe0000ffff0001fffff81fffffc007fffffc3fffffdc3bffffe807ffffe007fffffc3efffffc37ffffbffffff800001ff800001ff800001ff8001ffff9ff7fffe000ffefe0008007e001bbffe0018007e005ffffe0018007ffff803fffffffffffffffffffffffff},
   file                          = {data/pdfs/47_2/LaitenbergerVieteSlivkoEtAl2023.pdf},
   doi                           = {10.25300/MISQ/2022/17347},
   author                        = {Laitenberger, Ulrich and Viete, Steffen and Slivko, Olga and Kummer, Michael and Borchert, Kathrin and Hirth, Matthias},
   journal                       = {MIS Quarterly},
   title                         = {Unemployment and online labor: evidence from microtasking},
   year                          = {2023},
   volume                        = {47},
   number                        = {2},
   pages                         = {771--802},
   url                           = {https://misq.umn.edu/unemployment-and-online-labor-evidence-from-microtasking.html},
   abstract                      = {We analyze the relationship between unemployment and the supply of online labor for microtasking. Using detailed U.S. data from a large microtasking platform between 2011 and 2015, we study the participation and the number of hours supplied by workers in the U.S. We found that more individuals registered on the platform and completed microtasks as the unemployment level in the commuting zone increased. This effect was strongest in regions with a high share of low-skilled workers. Our analyses of the intensive margin, wage elasticity, and temporal work patterns suggest that the increased participation was likely motivated by an effort to substitute income. Our findings suggest that microtasking platforms are an interesting online labor market for less educated workers. However, we also observed very low retention rates, indicative of a solely transient participation effect.},
   language                      = {eng},
}

