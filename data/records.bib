   colrev_pdf_id                 = {cpid2:fffffffffcffffffe007ffffc0020003e0f20007fffffffff000000ffc00003ffff01fffffc003fffffc3fffffe007fff80ee03ff800001ff800001ff800001ff800001ffa7ffffff87fffffffffffffe000ffffe0018007e0018007e0018007e0018007e0018007ffffbfffffff8007e31f8007ffffffffffffffffffffffff},
