@article{SrivastavaChandra2018,
   colrev_origin                 = {CROSSREF.bib/000763;
                                    DBLP.bib/001233;
                                    pdfs.bib/0000000046;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:CROSSREF.bib/000763;;
                                    title:CROSSREF.bib/000763;;
                                    year:CROSSREF.bib/000763;;
                                    volume:CROSSREF.bib/000763;;
                                    number:CROSSREF.bib/000763;;
