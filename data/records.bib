   colrev_pdf_id                 = {cpid2:fffffffffcffffffc007ffffc0020003e0d20007fffffffff800001ff800001fff8001fffff81fffffc003fffff00fffffe407ffff9001ffff8001fff800001ff800001ff800001ff800001ff800001ff800001ff83ffffff800005ff80000fffffffffffffffffffffffffffffffffff7a33fffffffffffffffffffffffffff},
   file                          = {data/pdfs/43_2/HuangChengalurSmithPinsonneault2019.pdf},
   doi                           = {10.25300/MISQ/2019/13225},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/HuangCP19},
   author                        = {Huang, Kuang-Yuan and Chengalur-Smith, InduShobha and Pinsonneault, Alain},
   journal                       = {MIS Quarterly},
   title                         = {Sharing Is Caring - Social Support Provision and Companionship Activities in Healthcare Virtual Support Communities},
   year                          = {2019},
   volume                        = {43},
   number                        = {2},
   pages                         = {395--423},
   url                           = {https://misq.org/sharing-is-caring-social-support-provision-and-companionship-activities-in-healthcare-virtual-support-communities.html},
   abstract                      = {Individuals increasingly rely on healthcare virtual support communities (HVSCs) for social support and companionship. While research provides interesting insights into the drivers of informational support in knowledge-sharing virtual communities, there is limited research on the antecedents of emotional support provision and companionship activities in HVSCs. The unique characteristics of HVSCs also justify the need to reexamine members’ voluntary provisions of help in such communities. This paper develops a model that examines the relationships between the structural, relational, and cognitive dimensions of social capital and the provision of informational and emotional support, and engagement in companionship activities in HVSCs. The model is tested based on data generated through an automated method that classifies and analyzes user-generated text in three healthcare virtual support communities (breast, prostate, and colorectal cancer). The results show that all three dimensions of social capital impact the provision of emotional support; both structural and relational capital facilitate engagement in companionship activities; and only cognitive capital enables the provision of informational support. Research and practical implications on the need to facilitate informational and emotional support provision and companionship activities in healthcare virtual support communities are discussed.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/43/2/395/5914/03_13225_ra_huangchengalur_smith.pdf},
   language                      = {eng},
}

