                                    pages:ORIGINAL;;},
   colrev_data_provenance        = {file:pdfs.bib/0000000101;;
                                    doi:pdfs.bib/0000000101;;
                                    abstract:CROSSREF.bib/001744;;
                                    url:DBLP.bib/001434;;
                                    colrev.dblp.dblp_key:CROSSREF.bib/001744;;
                                    language:CROSSREF.bib/001744;;
                                    fulltext:ORIGINAL;;},
   colrev_pdf_id                 = {cpid2:fffffffffcffffffc007ffffc0020003e0d20007ffffffffe0000007f800001fffc003fffff81fffff8001fffff81fffffc003fffff81ffffff433ffffa821ffff8141fff800001ff800001ff800001ff800001ff800001ff800001ff800001ff9effffff807ffffffffffffffffffffffffffffffffffffffffffffffffffff},
   file                          = {data/pdfs/46_1/AdomaviciusBockstedtCurleyEtAl2022.pdf},
   doi                           = {10.25300/MISQ/2022/16301},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/AdomaviciusBCZ22},
   author                        = {Adomavicius, Gediminas and Bockstedt, Jesse C. and Curley, Shawn P. and Zhang, Jingjing},
   journal                       = {MIS Quarterly},
   title                         = {Effects of Personalized Recommendations Versus Aggregate Ratings on Post-Consumption Preference Responses},
   year                          = {2022},
   volume                        = {46},
   number                        = {1},
   pages                         = {627--644},
   url                           = {https://dblp.org/rec/journals/misq/AdomaviciusBCZ22},
   abstract                      = {Online retailers use product ratings to signal quality and help consumers identify products for purchase. These ratings commonly take the form of either non-personalized, aggregate product ratings (i.e., the average rating a product received from a number of consumers such as “the average rating is 4.5/5 based on 100 reviews”), or personalized predicted preference ratings for a product (i.e., recommender-system-generated predictions for a consumer’s rating of a product such as “we think you’d rate this product 4.5/5”). Ratings in either format can provide decision aid to the consumer, but the two formats convey different types of product quality information and operate with different psychological mechanisms. Prior research has indicated that each recommendation type can significantly affect consumer’s post-experience preference ratings, constituting a judgmental bias, but has not compared the effects of these two common product-rating formats. Using a laboratory experiment, we show that aggregate ratings and personalized recommendations create similar biases on post-experience preference ratings when shown separately. Shown together, there is no cumulative increase in the effect. Instead, personalized recommendations tend to dominate. Our findings can help retailers determine how to use these different types of product ratings to most effectively serve their customers. Additionally, these results help to educate the consumer on how product-rating displays influence their stated preferences.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/46/1/627/7432/19_16301_rn_adomaviciuszhang.pdf},
   language                      = {eng},
}

