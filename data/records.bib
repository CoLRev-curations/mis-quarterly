@article{EatonElalufCalderwoodSorensenEtAl2015,
   colrev_origin                 = {CROSSREF.bib/001355;
                                    DBLP.bib/001044;
                                    pdfs.bib/0000000107;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:CROSSREF.bib/001355;;
                                    title:CROSSREF.bib/001355;;
                                    year:CROSSREF.bib/001355;;
                                    volume:CROSSREF.bib/001355;;
