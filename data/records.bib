                                    author:ORIGINAL;;
                                    pages:ORIGINAL;;},
   colrev_data_provenance        = {file:pdfs.bib/0000000107;;
                                    url:ORIGINAL;;
                                    colrev.dblp.dblp_key:CROSSREF.bib/001355;;
                                    language:CROSSREF.bib/001355;;
