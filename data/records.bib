@article{KramerShekhar2025,
   colrev_origin                 = {CROSSREF.bib/002111;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {author:CROSSREF.bib/002111;;
                                    journal:CROSSREF.bib/002111;;
                                    number:CROSSREF.bib/002111;;
                                    pages:CROSSREF.bib/002111;;
                                    title:CROSSREF.bib/002111;;
                                    volume:CROSSREF.bib/002111;;
                                    year:CROSSREF.bib/002111;;},
   colrev_data_provenance        = {abstract:CROSSREF.bib/002111;;
                                    doi:CROSSREF.bib/002111;;
                                    fulltext:CROSSREF.bib/002111;;
                                    language:CROSSREF.bib/002111;;},
   doi                           = {10.25300/MISQ/2024/18428},
   author                        = {Krämer, Jan and Shekhar, Shiva},
   journal                       = {MIS Quarterly},
   title                         = {Regulating Digital Platform Ecosystems Through Data sharing and Data Siloing: Consequences for Innovation and Welfare},
   year                          = {2025},
   volume                        = {49},
   number                        = {1},
   pages                         = {123--154},
   abstract                      = {Digital platform ecosystems thrive on their ability to acquire and leverage user data across multiple data-driven services. This enables dominant platforms to harness insights obtained from their primary markets, where user data is collected, thus gaining a competitive advantage in secondary markets, where they exploit this data. While data cross-use brings about efficiencies, policymakers worldwide have expressed concerns about the economic power and the potential distortion of competition and innovation incentives associated with it. To address these concerns, two distinct and targeted policy interventions have been suggested: data siloing, which restricts the cross-use of data within platform ecosystems, and mandated data sharing with competitors. Using an analytical model that examines data cross-use in digital platform ecosystems, we analyzed the impact of data siloing and data sharing obligations, and their interaction on competition, innovation, consumer welfare, and overall social welfare. Our findings indicate that an optimal policy involves data sharing without data siloing, whereas the EU’s Digital Markets Act currently mandates both types of data cross-use regulation.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/49/1/123/1765/05_ra_10.25300_misq_2024_18428.pdf},
   language                      = {eng},
}

