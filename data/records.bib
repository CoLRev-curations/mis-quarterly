   colrev_pdf_id                 = {cpid2:fffffffffcffffffc007ffffc0020003e0d20007fffffffff800001fff8003ffffffffffffc003fffffeffffffe007fffffc1fffffe007fffff7cffff800001ff800001ff800001ff800001ff800001ff800001ff92b33fffffffffffe7b8007f0038007ffff8007ffff8007e0ff8007e00f8007ffffffffffffffffffffffff},
