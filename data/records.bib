   colrev_pdf_id                 = {cpid2:fffffffffcffffffc007ffffc0020003e0d20007fffffffff000000ff000000ff000001ffffc1fffff0000fffffc3fffffc003fffff81ffffff00ffffff00ffffff7effff81c7c9ff800001ff800001ff800001ff800001ff800001ff800001ff963621ff8007fffffffffffffffffffffffffffffffffffffffffffffffffff},
   file                          = {data/pdfs/44_4/ChauNgaiGerowEtAl2020.pdf},
   doi                           = {10.25300/MISQ/2020/12165},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/ChauNGT20},
   author                        = {Chau, Dorothy C. K. and Ngai, Eric W. T. and Gerow, Jennifer E. and Thatcher, Jason Bennett},
   journal                       = {MIS Quarterly},
   title                         = {The Effects of Business-IT Strategic Alignment and IT Governance on Firm Performance - A Moderated Polynomial Regression Analysis},
   year                          = {2020},
   volume                        = {44},
   number                        = {4},
   pages                         = {1679--1703},
   url                           = {https://misq.org/the-effects-of-business-it-strategic-alignment-and-it-governance-on-firm-performance-a-moderated-polynomial-regression-analysis.html},
   abstract                      = {Organizations use IT to navigate uncertain, rapidly changing, and competitive environments. To achieve this, understanding the implications of the interplay among firm strategy, information technology (IT), and IT governance is critical to understanding firm success. In this work, we investigate the synergistic effects of business–IT strategic alignment (hereafter “alignment”), misalignment, and effectiveness of IT governance on firm performance among organizations with proactive/first-mover strategic orientations (hereafter “proactive organizations”). Using data from 87 organizations, we tested a moderated polynomial model that predicts alignment and misalignment’s effect on firm performance. The results indicated that effective IT governance in proactive organizations positively moderated the curvilinear relationship between alignment, misalignment, and firm performance. This paper contributes to research by offering a curvilinear and three-dimensional representation of the relationship between alignment, misalignment, and firm performance and by illustrating the moderating facets of IT governance. Moreover, for practice, it sheds light on the effects of misalignment, suggesting that proactive organizations with more effective IT governance are not likely to struggle with mild misalignment but may suffer more deleterious effects from severe misalignment. Our research sheds light on the conditions under which IT governance and alignment influence firm performance.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/44/4/1679/6596/07_12165_ra_chau.pdf},
   language                      = {eng},
}

