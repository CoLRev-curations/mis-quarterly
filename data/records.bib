                                    fulltext:ORIGINAL;;},
   colrev_pdf_id                 = {cpid2:fffffffffcffffffc007ffffc0020003e0920007fffffffff000000ffe0000fffffc3fffffc007fffffc3fffffe007fffffe7fffffe00ffffffc3fffffe007fff82d601ff800001ff800001ff800001ff800001ff800001ff800001ff9097ffff9ffffffffffffffffffffffffffffffe782bfffffffffffffffffffffffffff},
   file                          = {data/pdfs/43_4/GuerinHosanagarLiEtAl2019.pdf},
   doi                           = {10.25300/MISQ/2019/14857},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/GuerinHLS19},
   author                        = {Guerin, Roch and Hosanagar, Kartik and Li, Xinxin and Sen, Soumya},
   journal                       = {MIS Quarterly},
   title                         = {Shared or Dedicated Infrastructures - On the Impact of Reprovisioning Ability},
   year                          = {2019},
   volume                        = {43},
   number                        = {4},
   pages                         = {1059--1079},
   url                           = {https://misq.umn.edu/shared-or-dedicated-infrastructures-on-the-impact-of-reprovisioning-ability.html},
   abstract                      = {New technologies, such as virtualization, are transforming the way in which software and services are deployed and delivered to their users. They are behind the emergence of IT offerings such as cloud computing and converged networks, and manifest themselves through two important trends: (1) lower the cost of sharing a common infrastructure across multiple services with disparate resource requirements, and (2) dynamic provisioning of capacity in response to demand. Conventional wisdom is that both of these capabilities are synergistic, with greater provisioning flexibility improving the benefits derived from sharing computing or network resources. Consequently, a service operator should now always favor the use of a shared infrastructure over dedicated solutions when hosting multiple services. In this paper, we ask whether this is indeed the case, and investigate the dual impact of lower costs of sharing and provisioning flexibility on shared and dedicated infrastructures. The investigation reveals that while lower costs are always expected to favor infrastructure sharing, dynamic provisioning plays an ambiguous role. Reprovisioning improves both shared and dedicated solutions, but can do so differently and can sometimes favor a dedicated infrastructure. Our findings help illustrate that the technology trends, such as virtualization, behind cloud computing need not always favor the deployment of services on a shared infrastructure.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/43/4/1059/6346/02_14857_ra_guerin.pdf},
   language                      = {eng},
}

