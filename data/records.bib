                                    year:CROSSREF.bib/002034;;},
   colrev_data_provenance        = {abstract:CROSSREF.bib/002034;;
                                    doi:CROSSREF.bib/002034;;
                                    fulltext:CROSSREF.bib/002034;;
                                    language:CROSSREF.bib/002034;;},
   doi                           = {10.25300/MISQ/2021/16274},
   author                        = {Berente, Nicholas and Gu, Bin and Recker, Jan and Santhanam, Radhika},
   journal                       = {MIS Quarterly},
   title                         = {Managing Artificial Intelligence},
   year                          = {2021},
   volume                        = {45},
   number                        = {3},
   pages                         = {1433--1450},
   abstract                      = {Managing artificial intelligence (AI) marks the dawn of a new age of information technology management. Managing AI involves communicating, leading, coordinating, and controlling an ever-evolving frontier of computational advancements that references human intelligence in addressing ever more complex decisionmaking problems. It means making decisions about three related, interdependent facets of AI—autonomy, learning, and inscrutability—in the ongoing quest to push the frontiers of performance and scope of AI. We demonstrate how the frontiers of AI have shifted with time, and explain how the seven exemplar studies included in this special issue are helping us learn about management at the frontiers of AI. We close by speculating about future frontiers in managing AI and what role information systems scholarship has in exploring and shaping this future.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/45/3/1433/7191/14_16274_si_introduction.pdf},
   language                      = {eng},
}

