   colrev_pdf_id                 = {cpid2:fffffffffcffffffe007ffffc0020003e0f20007fffffffff000000ff000000ffffc7fffff0000fffffc3fffff0000fffffc3fffff0001fffffffffff800001ff800001ff800001ff8003ffff8117fffffffffffe000ffffe0008007e0018007e001bfffe001c007e6b7c007ffff8007e3ffe8ffffffffffffffffffffffffff},
