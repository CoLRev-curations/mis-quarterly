@article{RajaviDanaherNewby2024,
   colrev_origin                 = {CROSSREF.bib/001999;
                                    DBLP.bib/001550;},
   colrev_status                 = {rev_prescreen_included},
   colrev_masterdata_provenance  = {author:DBLP.bib/001550;;
                                    journal:DBLP.bib/001550;;
                                    number:DBLP.bib/001550;;
                                    pages:DBLP.bib/001550;;
                                    title:DBLP.bib/001550;;
                                    volume:DBLP.bib/001550;;
                                    year:DBLP.bib/001550;;},
   colrev_data_provenance        = {colrev.dblp.dblp_key:DBLP.bib/001550;;
                                    doi:DBLP.bib/001550;;
                                    language:LanguageDetector;;
                                    url:CROSSREF.bib/001999;;
                                    abstract:CROSSREF.bib/001999;;
                                    dblp_key:ORIGINAL;;
                                    fulltext:ORIGINAL;;},
   doi                           = {10.25300/MISQ/2024/18466},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/RajaviDN24},
   author                        = {Rajavi, Koushyar and Danaher, Brett and Newby, Jesse},
   journal                       = {MIS Quarterly},
   title                         = {Price, Piracy, and Search: Which Pirates Respond to Changes in the Legal Price?},
   year                          = {2024},
   volume                        = {48},
   number                        = {4},
   pages                         = {1537--1558},
   url                           = {https://misq.umn.edu/price-piracy-and-search-which-pirates-respond-to-changes-in-the-legal-price.html},
   abstract                      = {Prior research suggests that high prices may motivate the decision to pirate entertainment goods. We analyzed a natural experiment that decreased the tax rate, and hence also the net prices of e-books, by 14% in Ireland while several other European countries were not affected. Using country-specific data on piracy visits, we found that this price decrease caused only a small and statistically insignificant decrease in total e-book piracy visits. However, we further decomposed piracy visits into those of direct pirates, who navigated directly to piracy sites, and indirect pirates, who searched to find piracy sites. The 14% price decrease caused no change in direct piracy visits but caused a statistically significant 27% decrease in indirect piracy visits. These findings align with prior research suggesting that search can play an important role in piracy, but only for some pirates. Our results demonstrate the potential of using price to mitigate piracy, but they also highlight the challenges firms face in competing with piracy for experienced pirates. We conclude by detailing both the policy and managerial implications of our work.},
   dblp_key                      = {https://dblp.org/rec/journals/misq/RajaviDN24},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/48/4/1537/9774/09_rn_10_25300_misq_2024_18466.pdf},
   language                      = {eng},
}

