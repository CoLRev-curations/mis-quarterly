   colrev_pdf_id                 = {cpid2:fffffffffcffffffe007ffffc0020007e0f20003fffffffff080000ff000000ffffc4fffffa003ffffbfb1fff800001ff800001ff800001ff800001ff808051ff95ffffff840001fffffffffe0008007e14d8007e001b7bfe0018007e0018007e0018007e0018007e0098007ffffffffe5ff8fffffffffffffffffffffffffff},
   file                          = {data/pdfs/44_2/BrowneWalden2020.pdf},
   doi                           = {10.25300/MISQ/2020/14718},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/BrowneW20},
   author                        = {Browne, Glenn J. and Walden, Eric A.},
   journal                       = {MIS Quarterly},
   title                         = {Is There a Genetic Basis for Information Search Propensity? A Genotyping Experiment},
   year                          = {2020},
   volume                        = {44},
   number                        = {2},
   pages                         = {747--770},
   url                           = {https://misq.org/is-there-a-genetic-basis-for-information-search-propensity-a-genotyping-experiment.html},
   abstract                      = {In this work we explore the question of whether there is a genetic basis for people’s different propensities to search for information. Specifically, we test whether the rs1044396 polymorphism—one variation in the cholinergic receptor nicotinic alpha 4 (CHRNA4) gene—is a reliable predictor of propensity to search for information. A sample of 205 subjects performed an information search task and then donated genetic material, which was analyzed. Using these data we found that the rs1044396 polymorphism is associated with both search duration and the amount of information searched, contributing a genetic explanation for a portion of propensity to search for information. People with the C:C version of rs1044396 gathered 25% more information but spent 13% less time on each piece of information than people with T-alleles before making a decision. Thus, the amount of information that people gather and the temporal cost of gathering that information have a strong genetic component, which has implications for internet search strategies, information use, and information systems design.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/44/2/747/2012/09_14718_ra_brownewalden.pdf},
   language                      = {eng},
}

