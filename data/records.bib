   colrev_pdf_id                 = {cpid2:fffffffffc7fffffe007ffffe0020003e0f20007fffffffff000000ff000000ffff81ffffff00ffffffc1ffffff81ffffff81ffffdfffffff800001ff800001ff800001ff800001ff8007ffff807fffffe05ffffe0008007e1058007e00180ffe0018017e0018007e0018007e77fffffe73fffffffffffffffffffffffffffff},
   file                          = {data/pdfs/47_4/JiangRavichandranKuruzovich2023.pdf},
   doi                           = {10.25300/MISQ/2023/16216},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/JiangRK23},
   author                        = {Jiang, Lianlian (Dorothy) and Ravichandran, T. and Kuruzovich, Jason},
   journal                       = {MIS Quarterly},
   title                         = {Review moderation transparency and online reviews: evidence from a natural experiment},
   year                          = {2023},
   volume                        = {47},
   number                        = {4},
   pages                         = {1693--1708},
   url                           = {https://misq.umn.edu/review-moderation-transparency-and-online-reviews-evidence-from-a-natural-experiment.html},
   abstract                      = {This paper empirically investigates how review moderation transparency affects the volume, length, and negativity of reviews. A change to the Yelp platform in 2010, introducing review moderation and displaying filtered reviews, created a natural experiment. We used a panel dataset of online reviews from the same set of restaurants on both the Yelp and TripAdvisor platforms in a difference-in-differences (DID) model to test how review moderation transparency affected our outcome variables. We found that increasing review moderation transparency negatively affects review volume but positively affects review negativity. The results also indicate that providing review moderation transparency reduces review length, especially for reviews with positive sentiment. Our findings suggest that providing review moderation transparency induces users to invest less effort in review contributions, especially when they are submitting positive reviews. We discuss the theoretical and practical implications of these results as they relate to the design and use of online review platforms.},
   dblp_key                      = {https://dblp.org/rec/journals/misq/JiangRK23},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/47/4/1693/9023/13_rn_10_25300_misq_2023_16216.pdf},
   language                      = {eng},
}

