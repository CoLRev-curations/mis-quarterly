   colrev_pdf_id                 = {cpid2:fffffffffc7fffffe007ffffe0020003e0f20007fffffffff000000fe0000007ffe007fffffc3ffffff81ffffffc3ffff893601ff800001ff800001ff800001ff800001ff801fffff801a43ff8fffffffe01ffffe0008007e0b98007e0018047e001efffe0018007e0018007e009ffffffffffffffffffffffffffffffffffff},
   file                          = {data/pdfs/45_3/VaastPinsonneault2021.pdf},
   doi                           = {10.25300/MISQ/2021/16024},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/VaastP21},
   author                        = {Vaast, Emmanuelle and Pinsonneault, Alain},
   journal                       = {MIS Quarterly},
   title                         = {When Digital Technologies Enable and Threaten Occupational Identity - The Delicate Balancing Act of Data Scientists},
   year                          = {2021},
   volume                        = {45},
   number                        = {3},
   pages                         = {1087--1112},
   url                           = {https://misq.org/when-digital-technologies-enable-and-threaten-occupational-identity-the-delicate-balancing-act-of-data-scientists.html},
   abstract                      = {Occupations are increasingly embedded with and affected by digital technologies. These technologies both enable and threaten occupational identity and create two important tensions: they make the persistence of an occupation possible while also potentially rendering it obsolete, and they magnify both the similarity and distinctiveness of occupations with regard to other occupations. Based on the critical case study of an online community dedicated to data science, we investigate longitudinally how data scientists address the two tensions of occupational identity associated with digital technologies and reach transient syntheses in terms of “optimal distinctiveness” and “persistent extinction.” We propose that identity work associated with digital technologies follows a composite life-cycle and dialectical process. We explain that people constantly need to adjust and redefine their occupational identity, i.e., how they define who they are and what they do. We contribute to scholarship on digital technologies and identity work by illuminating how people deal in an ongoing manner with digital technologies that simultaneously enable and threaten their occupational identity.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/45/3/1087/7111/04_16024_ra_vaastpinsonneault.pdf},
   language                      = {eng},
}

