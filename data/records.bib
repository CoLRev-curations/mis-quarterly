@article{ChoiCantorHanEtAl2024,
   colrev_origin                 = {CROSSREF.bib/001884;
                                    DBLP.bib/001512;
                                    pdfs.bib/001890;},
   colrev_status                 = {rev_prescreen_included},
   colrev_masterdata_provenance  = {author:DBLP.bib/001512;;
                                    journal:DBLP.bib/001512;;
                                    number:DBLP.bib/001512;;
                                    pages:DBLP.bib/001512;;
