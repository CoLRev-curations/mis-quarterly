   colrev_pdf_id                 = {cpid2:fffffffffcffffffe007ffffc0020003e0f20007fffffffffc00003ff800001ff800001ffffc3fffff781efffffc3ffffff81efffffc3fffff781efffffffffff800001ff800001ff800001ff800001ff9317ffff87fffffffffffffe0008007e0018007e0018007e0018007ffff8007e07f8007ffffffffffffffffffffffff},
