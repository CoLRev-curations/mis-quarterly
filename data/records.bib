   author                        = {Jha, Srivardhini K. and Pinsonneault, Alain and Dubé, Laurette},
   journal                       = {MIS Quarterly},
   title                         = {The Evolution of an ICT Platform-Enabled Ecosystem for Poverty Alleviation - The Case of eKutir},
   year                          = {2016},
