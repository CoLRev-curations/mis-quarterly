   colrev_pdf_id                 = {cpid2:fffffffffcffffffe007ffffc0020003e0f20007fffffffffc00003ffe00007fff8001fffff00fffffe005fffffc7fffffe007fffffe7fffff8003fffffffffff800001ff800001ff800001ff87ffffff966bfbfffffffffe000901fe0018007e0018007e0018007ffff8007ffff8007e3ff8487ffffffffffffffffffffffff},
   file                          = {data/pdfs/41_1/HuangHenfridssonLiuEtAl2017.pdf},
