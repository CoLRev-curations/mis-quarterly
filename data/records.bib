   colrev_pdf_id                 = {cpid2:fffffffffcffffffc007ffffc0020003e0920007ffffffffe0000007fe00007ffffc3fffff0003fffff81fffffe007fffff81fffffe007fffffc3fffff8003fffffffffff800001ff800001ff800001ff800001ff800001ff80fe4dff80c8ffff800007fffffffffffffffffffffffffffffffffffffffffffffffffffffffff},
   file                          = {data/pdfs/41_2/NunamakerJrTwymanGiboneyEtAl2017.pdf},
   doi                           = {10.25300/MISQ/2017/41.2.01},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/NunamakerTGB17},
   author                        = {Nunamaker, Jay F. and Twyman, Nathan W. and Giboney, Justin Scott and Briggs, Robert O.},
   journal                       = {MIS Quarterly},
   title                         = {Creating High-Value Real-World Impact through Systematic Programs of Research},
   year                          = {2017},
   volume                        = {41},
   number                        = {2},
   pages                         = {335--351},
   url                           = {http://misq.org/creating-high-value-real-world-impact-through-systematic-programs-of-research.html},
   abstract                      = {An ongoing conversation in the Information Systems literature addresses the concern, “How can we conduct research that makes a difference?” A shortage of high-impact research will, over time, challenge the identity and weaken the viability of IS as an academic discipline. This paper presents the systematic high-impact research model (SHIR), an approach to conducting high-impact research. SHIR embodies the insight gained from three streams of high-impact research programs spanning more than 50 years. The SHIR framework rests on the proposition that IS researchers can produce higher-impact contributions by developing long-term research programs around major real-world issues, as opposed to ad hoc projects addressing a small piece of a large problem. These persistent research programs focus on addressing the entirety of an issue, by leveraging multidisciplinary, multiuniversity research centers that employ a breadth of research methods and large-scale projects. To function effectively, SHIR programs must be sustained by academic and practitioner partnerships, research centers, and outreach activities. We argue that SHIR research programs increase the likelihood of high impact research.},
   cited_by                      = {23},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/41/2/335/1454/01_13253_io_nunamaker.pdf},
   language                      = {eng},
}

