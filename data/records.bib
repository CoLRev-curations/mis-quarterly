@article{KimAyvaciRaghunathanEtAl2022a,
   colrev_origin                 = {CROSSREF.bib/002023;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {author:CROSSREF.bib/002023;;
                                    journal:CROSSREF.bib/002023;;
                                    number:CROSSREF.bib/002023;;
                                    pages:CROSSREF.bib/002023;;
                                    title:CROSSREF.bib/002023;;
                                    volume:CROSSREF.bib/002023;;
                                    year:CROSSREF.bib/002023;;},
   colrev_data_provenance        = {abstract:CROSSREF.bib/002023;;
                                    doi:CROSSREF.bib/002023;;
                                    fulltext:CROSSREF.bib/002023;;
                                    language:CROSSREF.bib/002023;;},
   doi                           = {10.25300/MISQ/2022/16199},
   author                        = {Kim, Yeongin and Ayvaci, Mehmet U.S. and Raghunathan, Srinivasan and Ayer, Turgay},
   journal                       = {MIS Quarterly},
   title                         = {When IT Creates Legal Vulnerability: Not Just Overutilization but Underprovisioning of Health Care Could be a Consequence},
   year                          = {2022},
   volume                        = {46},
   number                        = {3},
   pages                         = {1483--1516},
   abstract                      = {We study the potential impact of the legal vulnerability created by ubiquitous information technology (IT) and provide insights into its unintended consequences in a typical healthcare screening context. Screening policies determine the level of care provision (i.e., whether to conduct a test) based on patient risk information. If IT shares risk information with physicians in the testing stage, follow-up decisions may be more accurate. Yet, physicians may also face heightened legal risk from increased information visibility. In this context, we examine the socially optimal screening (based on risk information) and follow-up policies (based on risk and test information). Litigation is generally associated with the overutilization of health care because of physicians’ defensive medicine practices. In contrast, we find that the strategic underprovisioning of health care through screening policies could be a consequence of information sharing in the presence of litigation concerns. The underprovisioning of health care is aggravated if the precision of risk information relative to that of the medical test increases or the physician becomes more self-interested and less patient oriented. However, limits on malpractice damages can alleviate the underprovisioning of health care.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/46/3/1483/8060/07_16199_ra_ayvaci.pdf},
   language                      = {eng},
}

