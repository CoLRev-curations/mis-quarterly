@article{AralBrynjolfssonGuEtAl2024,
   colrev_origin                 = {CROSSREF.bib/001871;
                                    DBLP.bib/001505;
                                    pdfs.bib/001880;},
   colrev_status                 = {rev_prescreen_included},
   colrev_masterdata_provenance  = {author:ORIGINAL;;
                                    journal:DBLP.bib/001505;;
                                    number:DBLP.bib/001505;;
                                    pages:DBLP.bib/001505;;
                                    title:pdfs.bib/001880;;
                                    volume:DBLP.bib/001505;;
                                    year:DBLP.bib/001505;;},
   colrev_data_provenance        = {colrev.dblp.dblp_key:DBLP.bib/001505;;
                                    doi:DBLP.bib/001505;;
                                    language:LanguageDetector;;
                                    url:CROSSREF.bib/001871;;
                                    abstract:CROSSREF.bib/001871;;
                                    file:pdfs.bib/001880;;
                                    dblp_key:ORIGINAL;;
                                    fulltext:ORIGINAL;;},
   file                          = {data/pdfs/48_2/retrieve (17).pdf},
   doi                           = {10.25300/MISQ/2023/17420},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/AralBGWW24},
   author                        = {Aral, Sinan and Brynjolfsson, Erik and Gu, Chris and Wang, Hongchang and Wu, D.J.},
   journal                       = {MIS Quarterly},
   title                         = {Understanding the returns from integrated enterprise systems: the impacts of agile and phased implementation strategies},
   year                          = {2024},
   volume                        = {48},
   number                        = {2},
   pages                         = {749--774},
   url                           = {https://misq.umn.edu/understanding-the-returns-to-integrated-enterprise-systems-the-impacts-of-agile-and-phased-implementation-strategies.html},
   abstract                      = {How do firms benefit from integrated enterprise systems (IES), and how does the IES implementation strategy influence the returns from IES? We investigated the implementation strategy that firms should follow to integrate multiple enterprise systems regarding the timing of adoption and the richness of modules. Borrowing theories from software development literature and enterprise system implementation literature, we developed two IES implementation strategies, i.e., the agile strategy (simple, quick, and flexible) and the phased strategy (rich, phased, and pre-determined). We collected a sample of 675 public firms from 1997 to 2004 at the module level, enabling us to distinguish enterprise resource planning (ERP) systems from customer relationship management (CRM) and supply chain management (SCM) systems. Our data contained the timing of purchase and “go-live” events of these system modules, helping us understand firms’ detailed implementation decisions. We found that IES returns depend on the choices of ERP and CRM/SCM module foundation, ERP-CRM/SCM sequential connection, and the continued adoption of ERP and CRM/SCM modules. Fewer ERP or CRM/SCM modules at CRM/SCM go-live events, a quicker connection between ERP and CRM/SCM go-live events, and the continued adoption of ERP or CRM/SCM modules all were found to enhance IES returns. Our findings show that the agile strategy leads to more returns from IES than the phased strategy and suggest that firms should integrate multiple enterprise systems by going live with advanced system modules quickly after going live with basic enterprise system modules and by continually adding new modules.},
   dblp_key                      = {https://dblp.org/rec/journals/misq/AralBGWW24},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/48/2/749/9244/13_rn_10_25300_misq_2023_17420.pdf},
   language                      = {eng},
}

@article{ArazyLindbergRezaeiEtAl2020,
