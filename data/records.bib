   colrev_data_provenance        = {file:pdfs.bib/0000000198;;
                                    url:ORIGINAL;;
                                    doi:CROSSREF.bib/000666;;
                                    cited_by:CROSSREF.bib/000666;;
                                    colrev.dblp.dblp_key:CROSSREF.bib/000666;;
