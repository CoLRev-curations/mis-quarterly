   file                          = {data/pdfs/48_1/retrieve (12).pdf},
   doi                           = {10.25300/MISQ/2023/16499},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/Safadi24},
   author                        = {Safadi, Hani},
   journal                       = {MIS Quarterly},
   title                         = {Balancing affordances and constraints: designing enterprise social media for organizational knowledge work},
   year                          = {2024},
   volume                        = {48},
   number                        = {1},
   pages                         = {347--374},
   url                           = {https://misq.umn.edu/balancing-affordances-and-constraints-designing-enterprise-social-media-for-effective-organizational-knowledge-work.html},
   abstract                      = {Enterprise social media (ESM) is changing how knowledge workers interact and share information; however, a debate persists as to whether ESM is an adequate knowledge management system. ESM provides a rich set of affordances for organizational knowledge work, such as improved organizational memory, but also constrains knowledge work performance because of digital interruptions. Extending and complementing existing scholarship, this study asks the following research question: How can organizations design ESM to realize its knowledge work benefits? Using a computational agent-based model that incorporates the design features of ESM, workers’ attitudes, and resulting ESM-use affordances and constraints, this study shows how ESM-use outcomes are contingent both on the design of and users’ attitudes toward ESM. Specifically, the negative effects of ESM interactivity are mitigated when employees have a low transparency preference and access ESM without posting as much. The study further unpacks asymmetric engagement as the mechanism that leads low transparency configurations to be more resilient to the negative effects of interruptions driven by ESM interactivity. Asymmetric engagement—learning from posted content without interacting often—enables the gradual creation of organizational memory while maintaining a broad user base by minimizing interruptions. These results ultimately contribute a multilevel model of ESM use and knowledge work outcomes, enhancing the theoretical understanding of previously studied mechanisms such as communication visibility and providing implications for organizations designing ESM.},
   dblp_key                      = {https://dblp.org/rec/journals/misq/Safadi24},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/48/1/347/9260/12_ra-16499-safadi-to_journal-mb.pdf},
   language                      = {eng},
}

