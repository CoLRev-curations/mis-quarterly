                                    fulltext:ORIGINAL;;},
   colrev_pdf_id                 = {cpid2:fffffffffcffffffe007ffffc0020003e0f20007fffffffff000000ff800001fffe007fffff00fffff0000fffffc3fffffd807fffff81fffffc001fff800001ff800001ff800001ff800001ff800001ff800001ff9fffffff8007fffffff7ffffe01ffffe0008007e1f78007ffff8007e0ffffffffffffffffffffffffffffff},
   file                          = {data/pdfs/46_1/RezazadeMehriziNicoliniRodon2022.pdf},
   doi                           = {10.25300/MISQ/2022/14305},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/MehriziNR22},
   author                        = {Rezazade Mehrizi, Mohammad H. and Nicolini, Davide and Mòdol, Joan Rodon},
   journal                       = {MIS Quarterly},
   title                         = {How Do Organizations Learn from Information System Incidents? A Synthesis of the Past, Present, and Future},
   year                          = {2022},
   volume                        = {46},
   number                        = {1},
   pages                         = {531--590},
   url                           = {https://dblp.org/rec/journals/misq/MehriziNR22},
   abstract                      = {We review the literature on how organizations learn from information system (IS) incidents. We identify three modes of learning depending on the practices that constitute the learning process, the specific actors who play roles in learning, the temporal orientation of the learning practices, and the specific contextual focus of the learning. The literature focuses primarily on learning from past experience to draw lessons for future incidents (reflective learning mode). Yet, a growing stream of literature stresses the importance of learning through engagement with present incidents (embedded learning mode), and a few studies suggest that organizations can learn prospectively to prepare for future incidents (prospective learning mode). We argue that although these three learning modes are effective, they do not adequately explain how organizations learn from IS incidents when used in isolation. Since IS incidents unfold increasingly as sets of interacting events across information systems and organizational settings, organizational learning needs to be theorized as an iterative process among these learning modes. We synthesize these three learning modes into an integrative framework and theorize about their supportive and inhibiting relations. We suggest some opportunities for future research, which would advance our understanding of how organizations learn from IS incidents.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/46/1/531/7527/16_14305_tr_rezazademehrizi.pdf},
   language                      = {eng},
}

@article{RhueClark2022,
   colrev_origin                 = {CROSSREF.bib/002086;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {author:CROSSREF.bib/002086;;
                                    journal:CROSSREF.bib/002086;;
                                    number:CROSSREF.bib/002086;;
                                    pages:CROSSREF.bib/002086;;
                                    title:CROSSREF.bib/002086;;
                                    volume:CROSSREF.bib/002086;;
                                    year:CROSSREF.bib/002086;;},
   colrev_data_provenance        = {abstract:CROSSREF.bib/002086;;
                                    doi:CROSSREF.bib/002086;;
                                    fulltext:CROSSREF.bib/002086;;
                                    language:CROSSREF.bib/002086;;},
   doi                           = {10.25300/MISQ/2022/15214},
   author                        = {Rhue, Lauren and Clark, Jessica},
   journal                       = {MIS Quarterly},
   title                         = {Who Are You and What Are You Selling? Creator-Based and Product-Based Racial Cues in Crowdfunding},
   year                          = {2022},
   volume                        = {46},
   number                        = {4},
   pages                         = {2229--2260},
   abstract                      = {The display of personal information in crowdfunding campaigns is vital for facilitating trust; however, this information often communicates the racial identity of the fundraiser. We study the relationship between racial cues and crowdfunding success. Using data from more than 100,000 projects gathered from Kickstarter.com, we categorized racial cues as creator-based versus product-based. For each category, we derived racial cues in two different mediums: photo vs. textual. We used propensity score matching to estimate the effects of racial identity across racial groups, categories, and mediums. We found that the category of racial cues is associated with crowdfunding success. Projects with either creator-based or product-based cues of African American identity had lower success rates. In contrast, creator-based cues of Asian identity were associated with lower levels of success whereas product-based cues were associated with increased success. Furthermore, when product-based cues and creator-based cues were misaligned, we found that the outcomes more closely followed those associated with product-based cues, suggesting that backers are more attuned to product attributes. Our results also suggest that racial anonymity correlates with higher success rates, as compared to African American and Asian racial cues. Our study contributes to the understanding of racial identity on digital platforms across multiple contexts, mediums, and racial groups.},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/46/4/2229/2090/13_15214_ra_rhue.pdf},
   language                      = {eng},
}

