                                    volume:DBLP.bib/001556;;
                                    year:DBLP.bib/001556;;},
   colrev_data_provenance        = {colrev.dblp.dblp_key:DBLP.bib/001556;;
                                    doi:DBLP.bib/001556;;
                                    language:LanguageDetector;;
                                    url:CROSSREF.bib/001900;;
                                    abstract:CROSSREF.bib/001900;;
                                    dblp_key:ORIGINAL;;
                                    fulltext:ORIGINAL;;},
   doi                           = {10.25300/MISQ/2023/18088},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/misq/StelmaszakWD24},
   author                        = {Stelmaszak, Marta and Wagner, Erica L. and DuPont, Nicolle Nixon},
   journal                       = {MIS Quarterly},
   title                         = {Recognition in Personal Data: Data Warping, Recognition Concessions, and Social Justice},
   year                          = {2024},
   volume                        = {48},
   number                        = {4},
   pages                         = {1611--1636},
   url                           = {https://misq.umn.edu/recognition-in-personal-data-data-warping-recognition-concessions-and-social-justice.html},
   abstract                      = {Data-related harm and injustice are commonly viewed through instrumental, procedural, distributional, or representational theories of social justice. These theories do not account for the social injustice that occurs through the lack of recognition of individuals when data are first conceptualized. We explore the recognition of individuals in data conceptualization by drawing from information systems (IS) literature on data artifacts that acknowledges the fact that data are comprised of semantics and formats. Guided by recognition theory, we studied a project to expand sexual orientation and gender identity (SOGI) data collection at a public, U.S.-based LGBTQ+ welcoming university. We found that while the actors involved worked towards recognizing in SOGI data the fact that identities are layered, non-binary, plural, and fluid, the data themselves still misrecognized individuals due to data warping. We argue that data warping occurs because of recognition concessions between social recognition through data semantics and systems recognition through data formats. Such concessions are both necessary for some recognition but accessory to misrecognition. Our findings have implications for recognition theory, data justice, and information systems research, as well as for personal data in practice.},
   dblp_key                      = {https://dblp.org/rec/journals/misq/StelmaszakWD24},
   fulltext                      = {https://misq.umn.edu/misq/article-pdf/48/4/1611/9607/12_si_10_25300_misq_2023_18088.pdf},
   language                      = {eng},
}

